# ===== DB =====
DATABASE_URL=postgresql+psycopg2://app:app@db:5432/leftover
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=leftover

# ===== Redis (限缓存/限流，不存会话) =====
REDIS_URL=redis://redis:6379/0

# ===== MinIO =====
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=leftover

# ===== JWT =====
JWT_SECRET=change-me-in-prod
JWT_EXPIRES_DAYS=30

# ===== LLM 文本 (智谱直连; 文本走 coding 端点 + glm-5.3, 2026-08 Yk 提供) =====
LLM_TEXT_PROVIDER=zhipu
LLM_TEXT_MODEL=glm-5.3
LLM_TEXT_API_KEY=
LLM_TEXT_API_BASE=https://open.bigmodel.cn/api/coding/paas/v4

# ===== LLM 视觉 (标准端点 + 免费档 GLM-4.6V-Flash) =====
LLM_VISION_PROVIDER=zhipu
LLM_VISION_MODEL=glm-4.6v-flash
LLM_VISION_API_KEY=
LLM_VISION_API_BASE=https://open.bigmodel.cn/api/paas/v4

# ===== 安全钩子 (内网全 false，公网迁移改 true) =====
ENFORCE_HTTPS=false
PASSWORD_STRENGTH_CHECK=false
LOGIN_RATE_LIMIT=false
CORS_ORIGINS=*
